# EDGAR Cleaner Environment Configuration
# Copy this file to .env and modify as needed

# Environment
EDGAR_ENV=development

# Application settings
EDGAR_DEBUG=false
EDGAR_APP_NAME="EDGAR Cleaner"

# Processing configuration
EDGAR_PROCESSING__CHUNK_SIZE=4000
EDGAR_PROCESSING__PARALLEL_WORKERS=3
EDGAR_PROCESSING__ENABLE_TABLE_PROCESSING=true
EDGAR_PROCESSING__ENABLE_QUALITY_VALIDATION=true

# Logging configuration
EDGAR_LOGGING__LEVEL=INFO
EDGAR_LOGGING__FILE=logs/edgar_cleaner.log
EDGAR_LOGGING__CONSOLE_OUTPUT=true

# HTML cleaning settings
EDGAR_HTML_CLEANING__REMOVE_SCRIPTS=true
EDGAR_HTML_CLEANING__REMOVE_STYLES=true
EDGAR_HTML_CLEANING__NORMALIZE_WHITESPACE=true

# Table processing settings
EDGAR_TABLE_PROCESSING__FINANCIAL_TABLE_DETECTION=true
EDGAR_TABLE_PROCESSING__MAX_TABLE_SIZE=10000

# Paths
EDGAR_OUTPUT_DIR=output
EDGAR_LOG_DIR=output/logs
EDGAR_CONFIG_DIR=config

# API settings (if using API)
EDGAR_API_HOST=localhost
EDGAR_API_PORT=8000
EDGAR_API_WORKERS=1

# Performance settings
EDGAR_PROCESSING__MAX_FILE_SIZE=500MB
EDGAR_PROCESSING__PROCESSING_TIMEOUT=300

# Security settings (production)
EDGAR_SECURITY__INPUT_FILE_SIZE_LIMIT=500MB
EDGAR_SECURITY__ENABLE_RATE_LIMITING=false 