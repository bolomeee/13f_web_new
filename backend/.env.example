# Django配置 (Django Configuration)
DJANGO_SECRET_KEY=django-insecure-dev-key-change-this-in-production-13f-tracker-2026
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# 数据库配置 (Database Configuration)
# SQLite is used by default, no configuration needed

# CORS配置 (CORS Configuration)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# Celery配置 (Celery Configuration)
CELERY_BROKER_URL=redis://localhost:6379/0

# SEC EDGAR配置 (SEC EDGAR Configuration)
# 请修改为您的实际联系邮箱 (Please change to your actual contact email)
SEC_USER_AGENT=13F-Tracker admin@example.com
SEC_REQUEST_DELAY=0.1

# 日志级别 (Log Level)
DJANGO_LOG_LEVEL=INFO
